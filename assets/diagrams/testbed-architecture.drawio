<mxfile host="app.diagrams.net"><diagram id="iot-architecture" name="Architecture"><mxGraphModel dx="1200" dy="1080" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1080"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="router" value="Laboratory router&#10;Shared lab network&#10;Node 1 Ethernet / Node 2 Wi-Fi" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7eff7;strokeColor=#557789;fontColor=#143a50;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="85" width="380" height="85" /></mxCell><mxCell id="n1" value="Node 1 Environmental&#10;Raspberry Pi 3 + DHT11&#10;Temperature and humidity readings&#10;Acquisition source pending" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f4ed;strokeColor=#557789;fontColor=#143a50;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="235" width="500" height="150" /></mxCell><mxCell id="n2" value="Node 2 Physical security&#10;Raspberry Pi 5 + light / PIR / tamper&#10;Linux USB / block-device observations&#10;3 sensor scripts + original launcher included" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f4ed;strokeColor=#557789;fontColor=#143a50;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="235" width="500" height="150" /></mxCell><mxCell id="db" value="MySQL environmental history&#10;Timestamps + temperature + humidity&#10;Database host / schema to confirm&#10;No Node 1 sample supplied" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#557789;fontColor=#143a50;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="460" width="500" height="130" /></mxCell><mxCell id="ssd" value="External SSD evidence&#10;Sensor CSVs + Node 2 event.log + USB CSV&#10;Timeline generator and USB monitor source pending&#10;Samples are separate capture windows" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#557789;fontColor=#143a50;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geomet